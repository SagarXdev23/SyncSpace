# Copy to .env and replace the JWT values with independent, random secrets.
MONGODB_URI=mongodb://127.0.0.1:27017/syncspace
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-a-different-random-secret-at-least-32-characters
DEMO_ACCOUNT_PASSWORD=
CLIENT_URL=http://localhost:5173
PORT=5000
NODE_ENV=development

# Optional integrations
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=SyncSpace <no-reply@syncspace.local>
